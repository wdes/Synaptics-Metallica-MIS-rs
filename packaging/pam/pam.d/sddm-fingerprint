# /etc/pam.d/sddm-fingerprint — drop-in for sddm to try fingerprint
# at login.
#
# Add this line near the TOP of /etc/pam.d/sddm:
#
#   auth   sufficient   pam_exec.so expose_authtok   /usr/local/lib/synaptics-mis-pam.sh
#
# A successful match logs the user in without a password. If the
# match fails or times out, the user gets the normal password prompt.

auth   sufficient   pam_exec.so expose_authtok   /usr/local/lib/synaptics-mis-pam.sh
